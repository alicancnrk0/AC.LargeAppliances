@model ProductPage

@{
    ViewData["Title"] = "Ürün Sayfası";
}

<div class="row mb-6 gy-6">
    <div class="col-xl">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Ürün Sayfası</h5>
                @if (Model is null)
                {
                    <a class="btn btn-primary" asp-action="Create">Sayfa Oluştur</a>
                }
            </div>
            <div class="card-body">

                <div class="mb-6">
                    <label class="form-label" asp-for="HeroLeftButonText"></label>
                    <input type="text" class="form-control" asp-for="HeroLeftButonText" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="HeroLeftTitle"></label>
                    <input type="text" class="form-control" asp-for="HeroLeftTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="HeroLeftDescription"></label>
                    <input type="text" class="form-control" asp-for="HeroLeftDescription" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label">Sağ Görsel</label>
                    <img src="@Model?.HeroRightImageUrl" style="width:80px; height:50px; object-fit:contain; display:block;" />
                </div>

                @if (Model != null)
                {
                    <a class="btn btn-primary" asp-action="Edit">Düzenle</a>
                }
            </div>
        </div>
    </div>
</div>