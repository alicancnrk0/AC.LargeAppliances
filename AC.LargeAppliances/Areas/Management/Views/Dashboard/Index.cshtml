@using AC.LargeAppliances.Models.ViewModels
@model DashboardVM

@{
    ViewData["Title"] = "Kontrol Paneli";
}

<div class="row mb-6 gy-6">

    <div class="col-lg-6 col-md-6 col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 text-muted">İletişim İstekleri</p>
                        <h4 class="mb-0">@Model.TotalContactRequests</h4>
                        <small class="text-muted">
                            Okunmamış:
                            <span class="badge bg-warning">@Model.UnreadContactRequests</span>
                        </small>
                    </div>
                    <div class="avatar avatar-md">
                        <div class="avatar-initial rounded bg-label-danger">
                            <i class="bx bx-message-dots bx-md"></i>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-area="Management" asp-controller="ContactRequests" asp-action="Index" class="font-xs">İsteklere Git →</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 col-md-6 col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 text-muted">İndirim İstekleri</p>
                        <h4 class="mb-0">@Model.TotalDiscountRequests</h4>
                        <small class="text-muted">
                            Okunmamış:
                            <span class="badge bg-warning">@Model.UnreadDiscountRequests</span>
                        </small>
                    </div>
                    <div class="avatar avatar-md">
                        <div class="avatar-initial rounded bg-label-secondary">
                            <i class="bx bx-tag bx-md"></i>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-area="Management" asp-controller="DiscountRequests" asp-action="Index" class="font-xs">İsteklere Git →</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-12 col-md-6 col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 text-muted">Toplam Ürün</p>
                        <h4 class="mb-0">@Model.TotalProducts</h4>
                    </div>
                    <div class="avatar avatar-md">
                        <div class="avatar-initial rounded bg-label-primary">
                            <i class="bx bx-purchase-tag bx-md"></i>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-area="Management" asp-controller="Products" asp-action="Index" class="font-xs">Ürünlere Git →</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-12 col-md-6 col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 text-muted">Toplam Satıcı</p>
                        <h4 class="mb-0">@Model.TotalVendors</h4>
                    </div>
                    <div class="avatar avatar-md">
                        <div class="avatar-initial rounded bg-label-success">
                            <i class="bx bx-store-alt bx-md"></i>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-area="Management" asp-controller="Vendors" asp-action="Index" class="font-xs">Satıcılara Git →</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-12 col-md-6 col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 text-muted">Toplam Sponsor</p>
                        <h4 class="mb-0">@Model.TotalSponsors</h4>
                    </div>
                    <div class="avatar avatar-md">
                        <div class="avatar-initial rounded bg-label-warning">
                            <i class="bx bx-medal bx-md"></i>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-area="Management" asp-controller="Sponsors" asp-action="Index" class="font-xs">Sponsorlara Git →</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-12 col-md-6 col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 text-muted">Toplam Mağaza</p>
                        <h4 class="mb-0">@Model.TotalStores</h4>
                    </div>
                    <div class="avatar avatar-md">
                        <div class="avatar-initial rounded bg-label-info">
                            <i class="bx bx-buildings bx-md"></i>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-area="Management" asp-controller="Stores" asp-action="Index" class="font-xs">Mağazalara Git →</a>
                </div>
            </div>
        </div>
    </div>


</div>