@model HomePage

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="row mb-6 gy-6">
    <div class="col-xl">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Ana Sayfa</h5>
                @if (Model is null)
                {
                    <a class="btn btn-primary" asp-action="Create">Sayfa Oluştur</a>
                }
            </div>
            <div class="card-body">

                <h6 class="mb-4">Hero</h6>

                <div class="mb-6">
                    <label class="form-label" asp-for="HeroSubTitle"></label>
                    <input type="text" class="form-control" asp-for="HeroSubTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="HeroTitle"></label>
                    <input type="text" class="form-control" asp-for="HeroTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="HeroValues"></label>
                    <input type="text" class="form-control" asp-for="HeroValues" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="HeroLeftButtonTitle"></label>
                    <input type="text" class="form-control" asp-for="HeroLeftButtonTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="HeroLefButtonUrl"></label>
                    <input type="text" class="form-control" asp-for="HeroLefButtonUrl" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="HeroRightButtonTitle"></label>
                    <input type="text" class="form-control" asp-for="HeroRightButtonTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="HeroRightButtonUrl"></label>
                    <input type="text" class="form-control" asp-for="HeroRightButtonUrl" readonly disabled />
                </div>

                <hr class="my-6" />
                <h6 class="mb-4">Mavi Kart</h6>

                <div class="mb-6">
                    <label class="form-label" asp-for="BlueTitle"></label>
                    <input type="text" class="form-control" asp-for="BlueTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="BlueSubTitle"></label>
                    <input type="text" class="form-control" asp-for="BlueSubTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="BlueValues"></label>
                    <input type="text" class="form-control" asp-for="BlueValues" readonly disabled />
                </div>

                <hr class="my-6" />
                <h6 class="mb-4">Turuncu Kart</h6>

                <div class="mb-6">
                    <label class="form-label" asp-for="OrangeTitle"></label>
                    <input type="text" class="form-control" asp-for="OrangeTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="OrangeSubTitle"></label>
                    <input type="text" class="form-control" asp-for="OrangeSubTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="OrangeValues"></label>
                    <input type="text" class="form-control" asp-for="OrangeValues" readonly disabled />
                </div>

                <hr class="my-6" />
                <h6 class="mb-4">Yeşil Kart</h6>

                <div class="mb-6">
                    <label class="form-label" asp-for="GreenTitle"></label>
                    <input type="text" class="form-control" asp-for="GreenTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="GreenSubTitle"></label>
                    <input type="text" class="form-control" asp-for="GreenSubTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="GreenValues"></label>
                    <input type="text" class="form-control" asp-for="GreenValues" readonly disabled />
                </div>

                <hr class="my-6" />
                <h6 class="mb-4">Şok Fiyat</h6>

                <div class="mb-6">
                    <label class="form-label" asp-for="ShockingTitle"></label>
                    <input type="text" class="form-control" asp-for="ShockingTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ShockingDescription"></label>
                    <input type="text" class="form-control" asp-for="ShockingDescription" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ShockingIconClass"></label>
                    <input type="text" class="form-control" asp-for="ShockingIconClass" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ShockingDateTime"></label>
                    <input type="text" class="form-control" asp-for="ShockingDateTime" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ShockingRightIconClass"></label>
                    <input type="text" class="form-control" asp-for="ShockingRightIconClass" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ShockingRightTitle"></label>
                    <input type="text" class="form-control" asp-for="ShockingRightTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ShockingRightSubTitle"></label>
                    <input type="text" class="form-control" asp-for="ShockingRightSubTitle" readonly disabled />
                </div>

                <hr class="my-6" />
                <h6 class="mb-4">Ürün Bölümü</h6>

                <div class="mb-6">
                    <label class="form-label" asp-for="ProductTitle"></label>
                    <input type="text" class="form-control" asp-for="ProductTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ProductSubTitle"></label>
                    <input type="text" class="form-control" asp-for="ProductSubTitle" readonly disabled />
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ProductHurry"></label>
                    <input type="text" class="form-control" asp-for="ProductHurry" readonly disabled />
                </div>

                @if (Model != null)
                {
                    <a class="btn btn-primary" asp-action="Edit">Düzenle</a>
                }
            </div>
        </div>
    </div>
</div>