@model HomePageVM

@{
    ViewData["Title"] = "Ana Sayfa";
    var firstProducts = Model.Products.FirstOrDefault();
    var restProducts = Model.Products.Skip(1).Take(6);
}

<section class="section-box">
    <div class="banner-hero banner-homepage3">
        <div class="container-banner">
            <div class="box-swiper">
                <div class="swiper-container swiper-group-1 swiper-home-3">
                    <div class="swiper-wrapper pt-5">

                        <div class="swiper-slide">
                            <div class="box-slide-bg-1">
                                <span class="label-green text-uppercase">@Model.HomePage?.HeroSubTitle</span>
                                <h1 class="font-68 mt-20">@Model.HomePage?.HeroTitle</h1>
                                <div class="mt-10">
                                    <ul class="list-disc">
                                        @foreach (var herofeature in Model.HomePage?.HeroValues?.Split('-') ?? Array.Empty<string>())
                                        {
                                            <li class="font-lg">@herofeature.Trim()</li>
                                        }
                                    </ul>
                                </div>
                                <div class="mt-30 mb-120"><a class="btn btn-brand-2 btn-gray-1000" href="@Model.HomePage?.HeroLefButtonUrl">@Model.HomePage?.HeroLeftButtonTitle</a><a class="btn btn-link text-underline" href="@Model.HomePage?.HeroRightButtonUrl">@Model.HomePage?.HeroRightButtonTitle</a></div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="section-box mt-30">
    <div class="container">
        <ul class="list-col-5">
            @foreach (var item in Model.CardItems)
            {
                <li>
                    <div class="item-list">
                        <div class="icon-left"><img src="@(item.IconImagePath)" alt="@item.Title"></div>
                        <div class="info-right">
                            <h5 class="font-lg-bold color-gray-100">@item.Title</h5>
                            <p class="font-sm color-gray-500">@item.Description</p>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>
<section class="section-box mt-30">
    <div class="container">
        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 mb-30">
                <div class="bg-19 pt-30 box-bdrd-4 block-water">
                    <h3 class="font-xl mb-10">@Model.HomePage?.BlueTitle</h3>
                    <p class="font-16 color-brand-3 mb-10">@Model.HomePage?.BlueSubTitle</p>
                    <div>
                        <ul class="list-disc mt-10">
                            @foreach (var bluefeature in Model.HomePage?.BlueValues?.Split('-') ?? Array.Empty<string>())
                            {
                                <li class="font-11">@bluefeature.Trim()</li>

                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-xl-5 col-lg-5 col-md-6 col-sm-12 mb-30">
                <div class="bg-20 pt-30 box-bdrd-4 block-kitchen">
                    <h3 class="font-xl mb-10">@Model.HomePage?.OrangeTitle</h3>
                    <p class="font-16 color-brand-3 mb-10">@Model.HomePage?.OrangeSubTitle</p><a class="btn btn-link font-xs pl-0 text-uppercase color-brand-1" asp-action="Products">@Model.HomePage?.OrangeValues</a>
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12">
                <div class="bg-21 pt-30 box-bdrd-4 block-electric">
                    <h3 class="font-xl mb-5">@Model.HomePage?.GreenTitle</h3>
                    <p class="font-16 mb-10">@Model.HomePage?.GreenSubTitle</p><a class="btn btn-link font-xs pl-0 text-uppercase color-brand-1" asp-action="Products">@Model.HomePage?.GreenValues</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-box pt-50">
    <div class="container">
        <div class="bg-9 box-bdrd-4 pt-35 pb-35 pl-25 pr-25">
            <div class="head-main">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="@Model.HomePage?.ShockingIconClass">
                            <h3 class="mb-5">@Model.HomePage?.ShockingTitle</h3>
                            <p class="font-16 font-bold color-gray-900">@Model.HomePage?.ShockingDescription</p>
                        </div>
                    </div>
                    <div class="col-lg-6 text-end">
                        <div class="box-all-hurry box-all-hurry-round">
                            <div class="d-inline-block box-text-hurryup"><span class="font-md-bold color-gray-900">@Model.HomePage?.ShockingRightTitle</span><br><span class="font-xs color-gray-500">@Model.HomePage?.ShockingRightSubTitle:</span></div>
                            <div class="box-count box-count-square hide-period">
                                <div class="deals-countdown" data-countdown="@Model.HomePage?.ShockingDateTime"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-0">
                <div class="list-products-5">

                    @foreach(var shocking in Model.MostDiscountedProducts)
                    {
                        <div class="card-grid-style-3 hover-show hover-hide-show-cart">
                            <div class="card-grid-inner">
                                @if (shocking.OldPrice.HasValue && shocking.OldPrice > 0)
                                {
                                    var discount = (int)(100 - (shocking.Price * 100 / shocking.OldPrice.Value));

                                    <div class="image-box"><span class="label bg-brand-2">-%@discount</span><a asp-action="ProductView" asp-route-id="@shocking.Id"><img src="@shocking.Images.OrderBy(x => x.SortOrder).FirstOrDefault()?.ImageUrl" alt="@shocking.Title"></a></div>

                                }
                                <div class="box-count">
                                    <div class="deals-countdown" data-countdown="@Model.HomePage?.ShockingDateTime"></div>
                                </div>
                                <div class="info-right">
                                    <span class="font-xs color-gray-500">@shocking.Vendor?.Name</span><br><a class="color-brand-3 font-sm-bold" asp-action="ProductView" asp-route-id="@shocking.Id">@shocking.Title</a>
                                    <div class="rating"><img src="assets/imgs/template/icons/star.svg" alt="@shocking.Title"><img src="assets/imgs/template/icons/star.svg" alt="@shocking.Title"><img src="assets/imgs/template/icons/star.svg" alt="@shocking.Title"><img src="assets/imgs/template/icons/star.svg" alt="@shocking.Title"><img src="assets/imgs/template/icons/star.svg" alt="@shocking.Title"><span class="font-xs color-gray-500"> (@shocking.StarsCount)</span></div>
                                    <div class="price-info"><strong class="font-lg-bold color-brand-3 price-main">₺@shocking.Price</strong><span class="color-gray-500 price-line">₺@shocking.OldPrice</span></div>
   
                                    <div class="mt-20 box-add-cart"><a class="btn btn-cart" asp-action="ProductView" asp-route-id="@shocking.Id">Yakında</a></div>
                                    <ul class="list-features">
                                        <li> 2-gün içinde Kargo. Ücretsiz Kargo</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</section>
<section class="section-box pt-50">
    <div class="container">
        <div class="head-main bd-gray-200">
            <div class="row">
                <div class="col-xl-7 col-lg-6">
                    <h3 class="mb-5">@Model.HomePage?.ProductTitle</h3>
                    <p class="font-base color-gray-500">@Model.HomePage?.ProductSubTitle</p>
                </div>
            </div>
        </div>
        <div class="tab-content">
            <div class="tab-pane fade active show" id="tab-2-all" role="tabpanel" aria-labelledby="tab-2-all">
                <div class="row">
                    @if(firstProducts != null)
                    {
                        <div class="col-lg-4">
                            <div class="card-grid-style-3 hover-show hurry-up hurry-up-2">
                                <div class="card-grid-inner">
                                    <div class="image-box">
                                        <div class="box-swiper">
                                            <div class="swiper-container swiper-tab" data-index="1">
                                                <div class="swiper-wrapper pt-5">
                                                    <div class="swiper-slide"><img src="@firstProducts.Images.OrderBy(x=> x.SortOrder).FirstOrDefault()?.ImageUrl" alt="@firstProducts.Title"></div>  
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-center mt-10 mb-15">
                                        <h4>Özel Teklif</h4>
                                        <p class="font-base color-gray-500">Teklif süresi zamana kadar geçerlidir</p>
                                    </div>
                                    <div class="box-count box-count-square">
                                        <div class="deals-countdown" data-countdown="@Model.HomePage?.ShockingDateTime"></div>
                                    </div>
                                    <div class="divide"></div>
                                    <div class="info-right">
                                        <span class="font-xs color-gray-500">@firstProducts.Vendor?.Name</span><br><a class="color-brand-3 font-sm-bold" asp-action="ProductView" asp-route-id="@firstProducts.Id">
                                        <h5>@firstProducts.Title</h5>
                                    </a>
                                    <div class="rating"><img src="assets/imgs/template/icons/star.svg" alt="@firstProducts.Title"><img src="assets/imgs/template/icons/star.svg" alt="@firstProducts.Title"><img src="assets/imgs/template/icons/star.svg" alt="@firstProducts.Title"><img src="assets/imgs/template/icons/star.svg" alt="@firstProducts.Title"><img src="assets/imgs/template/icons/star.svg" alt="@firstProducts.Title"><span class="font-xs color-gray-500 ml-5">(@firstProducts.StarsCount)</span></div>
                                    <div class="price-info">
                                        <h3 class="color-brand-3 price-main d-inline-block">₺@firstProducts.Price</h3><span class="color-gray-500 price-line">₺@firstProducts.OldPrice</span>
                                    </div>
                                    <div class="divide"></div>
                                    <ul class="list-features mb-30">
                                        @if (!string.IsNullOrWhiteSpace(firstProducts.Description))
                                            {
                                                foreach(var product in firstProducts.Description.Split("-"))
                                                {
                                                <li> @product.Trim()</li>

                                                }
                                            }

                                    </ul><a class="btn btn-cart" asp-action="ProductView" asp-route-id="@firstProducts.Id">Yakında</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    } 
                    

                <div class="col-lg-8">
                    <div class="row">
                            @foreach(var product in restProducts)
                            {
                            <div class="col-lg-4 col-md-6 col-sm-6">
                                <div class="card-grid-style-3">
                                    <div class="card-grid-inner">
                                        <div class="image-box">
                                            @if (product.OldPrice.HasValue && product.OldPrice > 0)
                                            {
                                                var discount = (int)(100 - (product.Price * 100 / product.OldPrice.Value));

                                                <span class="label bg-brand-2">-%@discount</span><a asp-action="ProductView" asp-route-id="@product.Id"><img src="@product.Images.OrderBy(x=> x.SortOrder).FirstOrDefault()?.ImageUrl" alt="@product.Title"></a>

                                            }
                                        </div>
                                        <div class="box-count">
                                            <div class="deals-countdown" data-countdown="@Model.HomePage?.ShockingDateTime"></div>
                                        </div>
                                        <div class="info-right">
                                            <span class="font-xs color-gray-500">@product.Vendor?.Name</span><br><a class="color-brand-3 font-sm-bold" asp-action="ProductView" asp-route-id="@product.Id">@product.Title</a>
                                            <div class="rating"><img src="assets/imgs/template/icons/star.svg" alt="@product.Title"><img src="assets/imgs/template/icons/star.svg" alt="@product.Title"><img src="assets/imgs/template/icons/star.svg" alt="@product.Title"><img src="assets/imgs/template/icons/star.svg" alt="@product.Title"><img src="assets/imgs/template/icons/star.svg" alt="@product.Title"><span class="font-xs color-gray-500">(@product.StarsCount)</span></div>
                                            <div class="price-info"><strong class="font-lg-bold color-brand-3 price-main">₺@product.Price</strong><span class="color-gray-500 price-line">₺@product.OldPrice</span></div>
                                            <div class="mt-20"><a class="btn btn-cart" asp-action="ProductView" asp-route-id="@product.Id">Yakında</a></div>
 
                                        </div>
                                    </div>
                                </div>
                            </div>

                            }

                    </div>
                </div>
            </div>
        </div>

</div>
</div>
</section>







<div class="section-box mt-70 mb-70">
    <div class="section-box">
        <div class="container">
            <div class="list-brands list-none-border">
                <div class="box-swiper">
                    <div class="swiper-container swiper-group-10">
                        <div class="swiper-wrapper">
                            @foreach(var sponsor in Model.Sponsors.Take(10))
                            {
                                <div class="swiper-slide text-black">
                                    <img src="@sponsor.ImageUrl" alt="@sponsor.ImageAlt" style="opacity: 0.8; filter: grayscale(0%);">
                                </div>

                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<section class="section-box box-newsletter">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-7 col-sm-12">
                <h3 class="color-white">@Model.Discount?.Title <span class="color-warning">@Model.Discount?.DiscountCount</span> @Model.Discount?.TitleSpan</h3>
                <p class="font-lg color-white">@Model.Discount?.Description</p>
            </div>
            <div class="col-lg-4 col-md-5 col-sm-12">
                <div class="box-form-newsletter mt-15">
                    <form asp-controller="Home" asp-action="Subscribe" method="post">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                        @Html.AntiForgeryToken()
                        <input class="input-newsletter font-xs" name="mailAddress" placeholder="E-posta adresiniz">
                        <button class="btn btn-brand-2" type="submit">@Model.Discount?.SignButton</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
