@using AC.LargeAppliances.Models.Entities
@model ProductViewVM

@{
    ViewData["Title"] = Model.Product?.Title;
}

<section class="section-box shop-template">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="gallery-image">
                    <div class="galleries">
                        <div class="detail-gallery">
                            @if(Model.Product?.OldPrice.HasValue == true && Model.Product.OldPrice > 0)
                            {
                                var discount = (int)(100 - (Model.Product.Price * 100 / Model.Product.OldPrice.Value));
                                <label class="label">-%@discount</label>
                            }
                            
                            <div class="product-image-slider">
                                @foreach (var image in Model.Product?.Images ?? new List<ProductImage>())
                                {
                                    <figure class="border-radius-10">
                                        <img src="@image.ImageUrl" alt="@Model.Product?.Title">
                                    </figure>

                                }
                            </div>
                        </div>
                        <div class="slider-nav-thumbnails">
                            @foreach(var image in Model.Product?.Images ?? new List<ProductImage>())
                            {
                                <div>
                                    <div class="item-thumb">
                                        <img src="@image.ImageUrl" alt="@Model.Product?.Title">
                                    </div>
                                </div>
                            }
                           
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <h3 class="color-brand-3 mb-25">@Model.Product?.Title</h3><span class="bytext">Üreten</span><a class="byAUthor" asp-action="Vendors"> @Model.Product?.Vendor?.Name</a>
                <div class="rating mt-5"><img src="~/assets/imgs/template/icons/star.svg" alt="@Model.Product?.Title"><img src="~/assets/imgs/template/icons/star.svg" alt="@Model.Product?.Title"><img src="~/assets/imgs/template/icons/star.svg" alt="@Model.Product?.Title"><img src="~/assets/imgs/template/icons/star.svg" alt="@Model.Product?.Title"><img src="~/assets/imgs/template/icons/star.svg" alt="@Model.Product?.Title"><span class="font-xs color-gray-500"> @Model.Product?.StarsCount</span></div>
                <div class="border-bottom pt-20 mb-40"></div>
                <div class="box-product-price">
                    <h3 class="color-brand-3 price-main d-inline-block mr-10">₺@Model.Product?.Price</h3><span class="color-gray-500 price-line font-xl line-througt">₺@Model.Product?.OldPrice</span>
                </div>
                <div class="product-description mt-20 color-gray-900">
                    @if(!string.IsNullOrWhiteSpace(Model.Product?.Description))
                    {
                        foreach (var feature in Model.Product.Description.Split('-'))
                        {
                            <br>@feature.Trim()
                        }
                    }
                    </div>
                <div class="buy-product mt-20">
                    <p class="font-sm mb-20">Adet</p>
                    <div class="box-quantity">
                        <div class="input-quantity">
                            <input class="font-xl color-brand-3" type="text" value="1"><span class="minus-cart"></span><span class="plus-cart"></span>
                        </div>
                        <div class="button-buy"><a class="btn btn-buy" asp-action="ProductView" asp-route-id="@Model.Product?.Id">Yakında</a></div>
                    </div>
                </div>
                <div class="border-bottom pt-30 mb-20"></div><a class="mr-30" asp-action="Products"><span class="btn btn-wishlist mr-5 opacity-100 transform-none"></span><span class="font-md color-gray-900">Benzer Ürünler</span></a><a asp-action="Vendors"><span class="btn btn-compare mr-5 opacity-100 transform-none"></span><span class="font-md color-gray-900">Satıcılar</span></a>
                <div class="info-product mt-20 font-md color-gray-900">SKU: @Model.Product?.SKU<br>Etiket: @Model.Product?.Tags</div>
                <div class="mt-20"><a class="font-md color-gray-900" asp-action="About">ECOM E-Ticaret Platform farkıyla</a></div>
            </div>
        </div>
        <div class="border-bottom pt-20 mb-40"></div>
    </div>
</section>
<section class="section-box shop-template">
    <div class="container">
        <div class="pt-30 mb-10">
            <ul class="nav nav-tabs nav-tabs-product" role="tablist">
                <li><a class="active" href="#tab-description" data-bs-toggle="tab" role="tab" aria-controls="tab-description" aria-selected="true">Açıklama</a></li>
                <li><a href="#tab-specification" data-bs-toggle="tab" role="tab" aria-controls="tab-specification" aria-selected="true">Teknik Özellikler</a></li>
                <li><a href="#tab-additional" data-bs-toggle="tab" role="tab" aria-controls="tab-additional" aria-selected="true">Ek Bilgiler</a></li>
                <li><a href="#tab-vendor" data-bs-toggle="tab" role="tab" aria-controls="tab-vendor" aria-selected="true">Satıcı</a></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade active show" id="tab-description" role="tabpanel" aria-labelledby="tab-description">
                    <div class="display-text-short">
                        @Model.Product?.Description
                    </div>
                </div>
                <div class="tab-pane fade" id="tab-specification" role="tabpanel" aria-labelledby="tab-specification">
                    <h5 class="mb-25">Teknik Özellikler</h5>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            @foreach(var feature in Model.Product.Features.OrderBy(x=> x.SortOrder))
                            {
                                <tr>
                                    <td>@feature.Key</td>
                                    <td>@feature.Value</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="tab-additional" role="tabpanel" aria-labelledby="tab-additional">
                    <h5 class="mb-25">Ek bilgiler</h5>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <tbody>
                                @foreach(var additional in Model.Product.AdditionalInfos)
                                {
                                    <tr>
                                        <td>@additional.Key</td>
                                        <td>
                                            <p>@additional.Value</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <div class="tab-pane fade" id="tab-vendor" role="tabpanel" aria-labelledby="tab-vendor">
                    <div class="vendor-logo d-flex mb-30">
                        <img src="@Model.Product?.Vendor?.Img" alt="@Model.Product?.Vendor?.Name">
                        <div class="vendor-name ml-15">
                            <h6><a href="shop-vendor-single.html">@Model.Product?.Vendor?.Name</a></h6>
                            <div class="product-rate-cover text-end">
                                <div class="product-rate d-inline-block">
                                    <div class="product-rating" style="width: 90%"></div>
                                </div><span class="font-small ml-5 text-muted"> (@Model.Product?.Vendor?.ReviewCount yorum)</span>
                            </div>
                        </div>
                    </div>
                    <ul class="contact-infor mb-50">
                        <li><img src="~/assets/imgs/page/product/icon-location.svg" alt=""><strong>Adres:</strong><span> @Model.Product?.Vendor?.MapAddress</span></li>
                        <li><img src="~/assets/imgs/page/product/icon-contact.svg" alt=""><strong>İletişim Numarası:</strong><span> @Model.Product?.Vendor?.PhoneNumber</span></li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-box mt-90 mb-50">
    <div class="container">
        <ul class="list-col-5">

            @foreach (var item in Model.CardItems)
            {
                <li>
                    <div class="item-list">
                        <div class="icon-left"><img src="@(item.IconImagePath)" alt="@item.Title"></div>
                        <div class="info-right">
                            <h5 class="font-lg-bold color-gray-100">@item.Title</h5>
                            <p class="font-sm color-gray-500">@item.Description</p>
                        </div>
                    </div>
                </li>
            }

        </ul>
    </div>
</section>
<section class="section-box box-newsletter">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-7 col-sm-12">
                <h3 class="color-white">@Model.Discount?.Title <span class="color-warning">@Model.Discount?.DiscountCount</span> @Model.Discount?.TitleSpan</h3>
                <p class="font-lg color-white">@Model.Discount?.Description</p>
            </div>
            <div class="col-lg-4 col-md-5 col-sm-12">
                <div class="box-form-newsletter mt-15">
                    <form asp-controller="Home" asp-action="Subscribe" method="post">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                        @Html.AntiForgeryToken()
                        <input class="input-newsletter font-xs" name="mailAddress" placeholder="E-posta adresiniz">
                        <button class="btn btn-brand-2" type="submit">@Model.Discount?.SignButton</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

