@model ProductPageVM

@{
    ViewData["Title"] = "Ürünlerimiz";
}



<div class="section-box shop-template mt-30">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="sidebar-ads">
                    <div class="bg-electronic">
                        <span class="big-deal mb-5">@Model.ProductPage?.HeroLeftButonText</span>
                        <h4 class="font-25">@Model.ProductPage?.HeroLeftTitle</h4>
                        <p class="font-16 color-brand-3">@Model.ProductPage?.HeroLeftDescription</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="banner-top-gray-100">
                    <div class="banner-ads-top mb-30"><img src="@Model.ProductPage?.HeroRightImageUrl" alt="Ecom"></div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">

                <div class="list-products-5 mt-20">

                    @foreach(var product in Model.Products)
                    {
                        <div class="card-grid-style-3">
                            <div class="card-grid-inner">
                                @if(product.OldPrice.HasValue && product.OldPrice > 0)
                                {
                                    var discount = (int)(100 - (product.Price * 100 / product.OldPrice.Value));

                                    <div class="image-box"><span class="label bg-brand-2">-%@discount</span><a asp-action="ProductView" asp-route-id="@product.Id"><img src="@product.Images.OrderBy(x=> x.SortOrder).FirstOrDefault()?.ImageUrl" alt="@product.Title"></a></div>

                                }
                                <div class="info-right">
                                    <a class="font-xs color-gray-500" asp-action="Vendors">@product.Vendor?.Name</a><br><a class="color-brand-3 font-sm-bold" asp-action="ProductView" asp-route-id="@product.Id">@product.Title</a>
                                    <div class="rating"><img src="~/assets/imgs/template/icons/star.svg" alt="Ecom"><img src="~/assets/imgs/template/icons/star.svg" alt="Ecom"><img src="~/assets/imgs/template/icons/star.svg" alt="@product.Title"><img src="~/assets/imgs/template/icons/star.svg" alt="@product.Title"><img src="~/assets/imgs/template/icons/star.svg" alt="@product.Title"><span class="font-xs color-gray-500">@product.StarsCount</span></div>
                                    <div class="price-info"><strong class="font-lg-bold color-brand-3 price-main">₺@product.Price</strong><span class="color-gray-500 price-line">₺@product.OldPrice</span></div>
                                    <div class="mt-20 box-btn-cart"><a class="btn btn-cart" asp-action="ProductView" asp-route-id="@product.Id">Ürün Detayı</a></div>
                                    <ul class="list-features">
                                        @if (!string.IsNullOrWhiteSpace(product.Description))
                                        {
                                            foreach(var feature in product.Description.Split("-"))
                                            {
                                                <li>@feature.Trim()</li>

                                            }
                                        }


                                    </ul>
                                </div>
                            </div>
                        </div>
                    }



                </div>
                <nav>
                    <ul class="pagination">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item"><a class="page-link page-prev" asp-action="Products" asp-route-page="@(ViewBag.CurrentPage - 1)"></a></li>
                        }
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item">
                                <a class="page-link @(i == ViewBag.CurrentPage ? "active" : "")" asp-action="Products" asp-route-page="@i">@i</a>
                            </li>
                        }
                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item"><a class="page-link page-next" asp-action="Products" asp-route-page="@(ViewBag.CurrentPage + 1)"></a></li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
<section class="section-box mt-90 mb-50">
    <div class="container">
        <ul class="list-col-5">

            @foreach (var item in Model.CardItems)
            {
                <li>
                    <div class="item-list">
                        <div class="icon-left"><img src="@(item.IconImagePath)" alt="@item.Title"></div>
                        <div class="info-right">
                            <h5 class="font-lg-bold color-gray-100">@item.Title</h5>
                            <p class="font-sm color-gray-500">@item.Description</p>
                        </div>
                    </div>
                </li>
            }

        </ul>
    </div>
</section>
<section class="section-box box-newsletter">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-7 col-sm-12">
                <h3 class="color-white">@Model.Discount?.Title <span class="color-warning">@Model.Discount?.DiscountCount</span> @Model.Discount?.TitleSpan</h3>
                <p class="font-lg color-white">@Model.Discount?.Description</p>
            </div>
            <div class="col-lg-4 col-md-5 col-sm-12">
                <div class="box-form-newsletter mt-15">
                    <form asp-controller="Home" asp-action="Subscribe" method="post">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                        @Html.AntiForgeryToken()
                        <input class="input-newsletter font-xs" name="mailAddress" placeholder="E-posta adresiniz">
                        <button class="btn btn-brand-2" type="submit">@Model.Discount?.SignButton</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
